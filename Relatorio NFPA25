// ── Supabase helpers (callbacks, sem async) ─────────────────────
function sbFetch(url, opts, onOk, onErr) {
  var xhr = new XMLHttpRequest();
  xhr.open(opts.method || 'GET', url);
  xhr.setRequestHeader('apikey', SB_KEY);
  xhr.setRequestHeader('Authorization', 'Bearer ' + SB_KEY);
  xhr.setRequestHeader('Content-Type', 'application/json');
  xhr.setRequestHeader('Prefer', 'return=representation');
  xhr.onload = function() {
    if (xhr.status >= 200 && xhr.status < 300) {
      var data = null;
      try { data = JSON.parse(xhr.responseText); } catch(e) {}
      if (onOk) onOk(data);
    } else {
      if (onErr) onErr(xhr.responseText);
    }
  };
  xhr.onerror = function() { if (onErr) onErr('network error'); };
  xhr.send(opts.body || null);
}

function sbGet(table, qs, cb) {
  sbFetch(SB_URL + '/rest/v1/' + table + (qs ? '?' + qs : ''), {method:'GET'}, cb, function(e){console.warn('GET',table,e);if(cb)cb([]);});
}
function sbPost(table, body, cb) {
  sbFetch(SB_URL + '/rest/v1/' + table, {method:'POST', body: JSON.stringify(body)}, cb, function(e){console.warn('POST',table,e);});
}
function sbPatch(table, qs, body, cb) {
  sbFetch(SB_URL + '/rest/v1/' + table + '?' + qs, {method:'PATCH', body: JSON.stringify(body)}, cb, function(e){console.warn('PATCH',table,e);});
}

