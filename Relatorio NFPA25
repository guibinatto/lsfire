var PER_LABEL = {semanal:'Semanal', mensal:'Mensal', trimestral:'Trimestral', semestral:'Semestral', anual:'Anual'};

function carregarDados() {
  sbGet('clientes', 'select=id,nome,cnpj,contato,telefone,email,endereco&ativo=eq.true&order=nome.asc', function(d){
    _clis = d || [];
