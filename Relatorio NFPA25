}

function setBdg(on) {
  var b = document.getElementById('sb-bdg');
  if (!b) return;
  b.style.display = 'block';
  if (on) {
    b.style.cssText = 'position:fixed;top:10px;left:10px;padding:4px 10px;border-radius:12px;font-size:10px;font-weight:700;z-index:500;background:#EAFAF1;color:#1E8449;border:1px solid #A9DFBF;display:block';
