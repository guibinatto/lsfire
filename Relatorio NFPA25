function updateUI() {
  for (var s = 1; s <= _TOTAL; s++) {
    var el = document.getElementById('s' + s);
    if (el) el.style.display = s === _step ? 'block' : 'none';
  }
  document.getElementById('suc').className = 'suc';
  document.getElementById('prog').style.width = Math.round(_step / _TOTAL * 100) + '%';
  document.getElementById('slbl').textContent = 'Passo ' + _step + ' de ' + _TOTAL;
  document.getElementById('nbk').style.display = _step > 1 ? 'inline-block' : 'none';
  document.getElementById('nxt').textContent = _step === _TOTAL ? 'Gerar PDF' : 'Proximo >';
  var dots = document.getElementById('dots');
  dots.innerHTML = '';
  for (var i = 1; i <= _TOTAL; i++) {
    var d = document.createElement('div');
    d.className = 'dot' + (_step === i ? ' a' : i < _step ? ' d' : '');
    dots.appendChild(d);
  }
}

function nextStep() {
  if (_step === 1) {
    if (!_per) { alert('Selecione uma periodicidade.'); return; }
    if (!gv('f-cli')) { alert('Informe o cliente.'); return; }
    if (!gv('f-tec')) { alert('Informe o tecnico responsavel.'); return; }
    if (!gv('f-data')) { alert('Informe a data da inspecao.'); return; }
  }
  if (_step === _TOTAL) { gerarPDF(); return; }
  _step++;
  updateUI();
  window.scrollTo(0, 0);
}

function prevStep() {
  if (_step > 1) { _step--; updateUI(); window.scrollTo(0, 0); }
}

