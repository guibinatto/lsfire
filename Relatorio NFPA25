  _pdfName = 'LS_Fire_NFPA25_' + (_per||'').toUpperCase() + '_OS' + os + '_' + cli + '.pdf';
  _pdfDoc = doc;

  enviarRegistro(tsim, tnao, tna, cf);

  document.getElementById('nav').style.display = 'none';
  document.querySelector('.hdr').style.display = 'none';
  document.getElementById('dots').style.display = 'none';
  document.getElementById('s' + _TOTAL).style.display = 'none';
  document.getElementById('suc').className = 'suc show';
  document.getElementById('suc-msg').textContent = 'Inspecao ' + (PER_LABEL[_per]||'') + ' concluida. SIM: ' + tsim + ' | NAO: ' + tnao + ' | N/A: ' + tna + ' | Conformidade: ' + cf + '%';
  setTimeout(dlPDF, 400);
}

function dlPDF() {
  if (!_pdfDoc) { alert('PDF ainda nao gerado.'); return; }
  try {
    _pdfDoc.save(_pdfName);
  } catch(e) {
    try {
      var uri = _pdfDoc.output('datauristring');
      var a = document.createElement('a');
      a.href = uri; a.download = _pdfName; a.target = '_blank';
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
    } catch(e2) {
      window.open(_pdfDoc.output('datauristring'), '_blank');
    }
  }
}

function enviarRegistro(sim, nao, na, cf) {
  var cliEl = document.getElementById('f-cli');
  var tecEl = document.getElementById('f-tec');
  var cliId = (cliEl && cliEl.dataset && cliEl.dataset.id) ? cliEl.dataset.id : null;
  var tecId = (tecEl && tecEl.dataset && tecEl.dataset.id) ? tecEl.dataset.id : null;
  sbPost('ordens_servico', {
    numero: gv('f-os'),
    tipo: 'NFPA 25 ITM - ' + (PER_LABEL[_per]||''),
    cliente_id: cliId, tecnico_id: tecId,
    cliente_nome: gv('f-cli'), tecnico_nome: gv('f-tec'),
    data: gv('f-data') || null, local_exec: gv('f-local'),
    norma: 'NFPA 25', status: 'concluido',
    total_ok: sim, total_nok: nao, total_na: na,
    observacoes: gv('f-obs'), pendencias: gv('f-pend'),
    checklist_json: _itens,
  }, null);
  if (cliId && gv('f-data')) {
    var proxDias = DIAS[_per] || 7;
    var d = new Date(gv('f-data') + 'T12:00:00');
    d.setDate(d.getDate() + proxDias);
    var proxData = d.toISOString().slice(0,10);
    var exis = null;
    for (var i = 0; i < _ctrl.length; i++) {
      if (_ctrl[i].cliente_id === cliId && _ctrl[i].periodo === _per) { exis = _ctrl[i]; break; }
    }
    if (exis) {
      sbPatch('itm_controles', 'cliente_id=eq.' + cliId + '&periodo=eq.' + _per,
        {ultima_data: gv('f-data'), proximo_data: proxData, tecnico_nome: gv('f-tec')}, null);
    } else {
      sbPost('itm_controles', {
        cliente_id: cliId, periodo: _per,
        ultima_data: gv('f-data'), proximo_data: proxData,
        tecnico_nome: gv('f-tec'), cliente_nome: gv('f-cli')
      }, null);
    }
  }
}

// ── Init ─────────────────────────────────────────────────────────
document.getElementById('f-data').value = new Date().toISOString().slice(0,10);
updateUI();
carregarDados();
</script>
