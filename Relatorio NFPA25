    b.style.cssText = 'position:fixed;top:10px;left:10px;padding:4px 10px;border-radius:12px;font-size:10px;font-weight:700;z-index:500;background:#FDEDEC;color:#C0392B;border:1px solid #F1948A;display:block';
    b.textContent = '● Offline';
  }
}

// ── Autocomplete sem arrows ──────────────────────────────────────
function acShow(tipo) {
  var inp = document.getElementById('f-' + tipo);
  var drop = document.getElementById('ac-' + tipo);
  var lista = tipo === 'cli' ? _clis : _tecs;
  if (!inp || !drop || !lista.length) return;
  var q = inp.value.toLowerCase().trim();
  var fl = [];
  for (var i = 0; i < lista.length; i++) {
    if (!q || lista[i].nome.toLowerCase().indexOf(q) >= 0) fl.push(lista[i]);
  }
  if (!fl.length) { drop.style.display = 'none'; return; }
  var html = '';
  for (var j = 0; j < fl.length; j++) {
    html += '<div class="ac-item" data-id="' + fl[j].id + '" data-nome="' + fl[j].nome.replace(/"/g,'&quot;') + '" ontouchend="acSel('' + tipo + '','' + fl[j].id + '',event)" onclick="acSel('' + tipo + '','' + fl[j].id + '',event)">' + fl[j].nome + '</div>';
  }
  drop.innerHTML = html;
  drop.style.display = 'block';
}

function acHide(tipo) {
  setTimeout(function() {
    var drop = document.getElementById('ac-' + tipo);
    if (drop) drop.style.display = 'none';
  }, 300);
}

function acSel(tipo, id, evt) {
  if (evt) { evt.preventDefault(); evt.stopPropagation(); }
  var lista = tipo === 'cli' ? _clis : _tecs;
  var item = null;
  for (var i = 0; i < lista.length; i++) {
    if (lista[i].id === id) { item = lista[i]; break; }
  }
  if (!item) return;
  var inp = document.getElementById('f-' + tipo);
  if (inp) { inp.value = item.nome; inp.dataset.id = id; }
  var drop = document.getElementById('ac-' + tipo);
  if (drop) drop.style.display = 'none';
  if (tipo === 'cli') {
    var fn = function(fid, val) { var e = document.getElementById(fid); if (e && val) e.value = val; };
    fn('f-end', item.endereco);
    fn('f-tel', item.telefone);
    fn('f-cont', item.contato);
    mostrarProximas(id);
  } else {
    var ec = document.getElementById('f-crea');
    if (ec && item.crea) ec.value = item.crea;
  }
}

function mostrarProximas(cliId) {
  var periodos = ['semanal','mensal','trimestral','semestral','anual'];
  var hoje = new Date();
  for (var p = 0; p < periodos.length; p++) {
    var per = periodos[p];
    var ctrl = null;
    for (var i = 0; i < _ctrl.length; i++) {
      if (_ctrl[i].cliente_id === cliId && _ctrl[i].periodo === per) { ctrl = _ctrl[i]; break; }
    }
    var el = document.getElementById('pn-' + per);
    if (!el) continue;
    if (!ctrl || !ctrl.ultima_data) { el.textContent = ''; continue; }
    var prox = new Date(ctrl.proximo_data + 'T12:00:00');
    var dr = Math.round((prox - hoje) / 86400000);
    if (dr < 0) el.textContent = 'Vencida ' + Math.abs(dr) + 'd';
    else if (dr === 0) el.textContent = 'Vence hoje!';
    else if (dr <= 7) el.textContent = dr + ' dias';
    else el.textContent = prox.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'});
  }
}

